# EHIPAP Environment Configuration Template
# Copy this file to .env and replace placeholder values with real credentials

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_USER=your-db-username
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=ehipap
DB_URL=jdbc:postgresql://your-db-host:5432/ehipap

# ─── Redis ────────────────────────────────────────────────────────
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here

# ─── Kafka ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9092

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-minimum-64-characters-long-random-string-here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── MinIO ────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://your-minio-host:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_DOCUMENTS=ehipap-documents
MINIO_BUCKET_PAYSLIPS=ehipap-payslips

# ─── Elasticsearch ────────────────────────────────────────────────
ELASTICSEARCH_HOST=your-elasticsearch-host
ELASTICSEARCH_PORT=9200

# ─── Keycloak ─────────────────────────────────────────────────────
KEYCLOAK_URL=http://your-keycloak-host:8080
KEYCLOAK_REALM=ehipap
KEYCLOAK_CLIENT_ID=ehipap-app
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# ─── Service URLs (for production deployment) ─────────────────────
AUTH_SERVICE_URL=https://your-auth-service-url
EMPLOYEE_SERVICE_URL=https://your-employee-service-url
PAYROLL_SERVICE_URL=https://your-payroll-service-url
ATTENDANCE_SERVICE_URL=https://your-attendance-service-url
RECRUITMENT_SERVICE_URL=https://your-recruitment-service-url
PERFORMANCE_SERVICE_URL=https://your-performance-service-url
NOTIFICATION_SERVICE_URL=https://your-notification-service-url
ANALYTICS_SERVICE_URL=https://your-analytics-service-url

# ─── CORS Configuration ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── Frontend ─────────────────────────────────────────────────────
VITE_API_BASE_URL=https://your-api-gateway-url
VITE_APP_NAME=EHIPAP
VITE_APP_VERSION=1.0.0
